<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Multiplayer</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <!-- $(GameManaged) / $(ModSDK) come from Directory.Build.props — see it to point the build at
       your own Phoenix Point install. -->
  <ItemGroup>
    <!-- tools/ are their own projects (RailCheck); the SDK glob must not swallow them into the mod. -->
    <Compile Remove="tools\**" />
    <!-- The SDK auto-excludes only $(BaseIntermediateOutputPath)/$(BaseOutputPath). Building with
         -p:BaseIntermediateOutputPath=obj\wipXX\ therefore leaves every OTHER obj\* visible to the
         glob, and each one holds a generated .NETFramework,...AssemblyAttributes.cs — so a second
         build in the same tree fails with CS0579 duplicate-attribute. Exclude the roots outright. -->
    <Compile Remove="obj\**" />
    <Compile Remove="bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's OWN shipped Steamworks binding (already loaded + initialised by PlatformSteam). -->
    <Reference Include="Facepunch.Steamworks.Win64">
      <HintPath>$(GameManaged)\Facepunch.Steamworks.Win64.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AK.Wwise.Event — the type every one of the game's sound defs is made of. Needed to POST one of
         the game's own cues (PingMarkers.Refuse); the game ships this assembly, so it is always present. -->
    <Reference Include="AK.Wwise.Unity.API.WwiseTypes">
      <HintPath>$(GameManaged)\AK.Wwise.Unity.API.WwiseTypes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ModSDK)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ParticleSystem lives in its own Unity module. Needed by PingMarkers.Tint, which loops and
         re-colours the ping marker's own radiating waves. -->
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net" />
  </ItemGroup>
</Project>
