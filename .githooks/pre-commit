#!/bin/sh
# Enable once per clone:  git config core.hooksPath .githooks
set -e
root=$(git rev-parse --show-toplevel)

pwsh -NoProfile -File "$root/tools/law-integrity.ps1" || exit 1

# RailCheck needs the real game assemblies. Probe list mirrors Program.cs:39-47.
managed=""
for p in \
    "$PhoenixPointDir" \
    "/c/Program Files (x86)/Steam/steamapps/common/Phoenix Point" \
    "/c/Steam/steamapps/common/Phoenix Point" \
    "/d/Steam/steamapps/common/Phoenix Point" \
    "/e/Steam/steamapps/common/Phoenix Point" \
    "/c/Program Files (x86)/Epic Games/PhoenixPoint" ; do
    [ -n "$p" ] && [ -d "$p/PhoenixPointWin64_Data/Managed" ] && { managed="$p"; break; }
done

if [ -z "$managed" ]; then
    echo ""
    echo "########################################################################"
    echo "##  RAILCHECK SKIPPED - no Phoenix Point install; laws NOT verified   ##"
    echo "##  on this machine. Set PhoenixPointDir and re-run to verify.        ##"
    echo "########################################################################"
    echo ""
    exit 0
fi

echo "RailCheck: using $managed"

# The dotnet first on PATH can be the x86 host with no SDK ("No .NET SDKs were found"), which aborts
# every commit in this tree until the caller prepends the x64 install by hand. Probe for a real SDK and
# fall back to the known x64 locations; keep plain `dotnet` when it already works (Linux/macOS/CI).
dotnet_bin="dotnet"
if [ -z "$(dotnet --list-sdks 2>/dev/null)" ]; then
    for d in "/c/Program Files/dotnet/dotnet.exe" "/usr/local/share/dotnet/dotnet" ; do
        [ -x "$d" ] && { dotnet_bin="$d"; break; }
    done
    [ "$dotnet_bin" = "dotnet" ] && { echo "pre-commit: no .NET SDK found (the dotnet on PATH has none)"; exit 1; }
    echo "RailCheck: PATH dotnet has no SDK, using $dotnet_bin"
fi

"$dotnet_bin" run -c Debug --project "$root/tools/RailCheck" || exit 1
